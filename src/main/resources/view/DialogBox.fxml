<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox"
         alignment="TOP_RIGHT"
         prefWidth="400.0"
         stylesheets="@../css/dialog-box.css"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog"
               maxWidth="280.0"
               wrapText="true">
            <HBox.margin>
                <Insets left="7.0" right="7.0" />
            </HBox.margin>
            <padding>
                <Insets top="6.0"
                        bottom="6.0"
                        left="6.0"
                        right="6.0" />
            </padding>
        </Label>

        <ImageView fx:id="displayPicture"
                   fitHeight="72.0"
                   fitWidth="72.0"
                   pickOnBounds="true"
                   preserveRatio="true" />
    </children>

    <padding>
        <Insets top="10.0"
                bottom="10.0"
                left="5.0"
                right="5.0" />
    </padding>
</fx:root>
